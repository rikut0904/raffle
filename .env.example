PORT=8080
DATABASE_URL=postgresql://postgres:password@hostname.railway.app:5432/railway
SESSION_SECRET=a-very-secret-random-string-at-least-32-chars
# Run AutoMigrate (default: false). Set to true only when schema changes are needed.
AUTO_MIGRATE=false

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Either set the JSON itself...
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-firebase-project-id"}

# Common ID: portal URL and backend API URL are separate in local development.
COMMON_ID_ORIGIN=http://localhost:13000
COMMON_ID_API_ORIGIN=http://localhost:18080
COMMON_ID_CLIENT_ID=<local-client-id>
COMMON_ID_REDIRECT_URI=http://localhost:8080/auth/callback
COMMON_ID_LOGOUT_REDIRECT_URI=http://localhost:8080/auth/logout/callback
COMMON_ID_API_KEY=<local-app-api-key>
